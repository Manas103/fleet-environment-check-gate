/target
*.pid
# All of sim/'s fleet data is regenerated by `python3 sim/setup_fleet.py sim --seed 42`
# (see README). Private SSH keys never belong in a public repo even as test fixtures, and
# sshd enforces key-file permission bits that NTFS/DrvFS mounts cannot represent anyway.
sim/keys/
sim/facts_clean/
sim/facts_faulted/
sim/authorized_keys_clean
sim/authorized_keys_faulted
sim/hosts.csv
sim/seeded_faults.json
sim/host_key
sim/host_key.pub
sim/sshd_config
