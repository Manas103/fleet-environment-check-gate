#!/usr/bin/env python3
"""Fleet simulation stub: stands in for the real `sysctl` on a simulated host, printing the
per-host synthetic kernel facts in sysctl's real `key = value` output format."""
import json
import os
import sys

facts_dir = os.environ["FACTS_DIR"]
host_id = os.environ["HOSTID"]
with open(os.path.join(facts_dir, f"{host_id}.json")) as f:
    facts = json.load(f)

keys = [a for a in sys.argv[1:] if not a.startswith("-")]
for key in keys:
    if key in facts["kernel"]:
        print(f"{key} = {facts['kernel'][key]}")
    else:
        print(f"sysctl: cannot stat /proc/sys/{key.replace('.', '/')}: No such file or directory", file=sys.stderr)
