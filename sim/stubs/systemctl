#!/usr/bin/env python3
"""Fleet simulation stub: stands in for the real `systemctl show <unit> --property=ActiveState`
on a simulated host."""
import json
import os
import sys

facts_dir = os.environ["FACTS_DIR"]
host_id = os.environ["HOSTID"]
with open(os.path.join(facts_dir, f"{host_id}.json")) as f:
    facts = json.load(f)

args = sys.argv[1:]
if len(args) < 2 or args[0] != "show":
    sys.exit(1)
unit = args[1]
state = facts["units"].get(unit)
if state is None:
    sys.exit(1)
print(f"ActiveState={state}")
