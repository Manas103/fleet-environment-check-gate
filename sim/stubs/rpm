#!/usr/bin/env python3
"""Fleet simulation stub: stands in for the real `rpm` on a simulated RHEL host."""
import json
import os
import sys

facts_dir = os.environ["FACTS_DIR"]
host_id = os.environ["HOSTID"]
with open(os.path.join(facts_dir, f"{host_id}.json")) as f:
    facts = json.load(f)

pkgs = [a for a in sys.argv[1:] if not a.startswith("-") and not a.startswith("%{")]
missing = False
for pkg in pkgs:
    if pkg in facts["packages"]:
        print(f"{pkg} {facts['packages'][pkg]}")
    else:
        print(f"package {pkg} is not installed", file=sys.stderr)
        missing = True
sys.exit(1 if missing else 0)
